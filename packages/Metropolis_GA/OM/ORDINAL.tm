class ORDINAL {
"""
Class for ordinals.
Auxillary class which can be used for e.g. iterating (in order)
over the track circuits in a path.
"""

Variables:
  ord;

Parameters:

  """
  The "value" of the ordinal. The first ordinal has
  value 0 and the value increases by 1 over the range
  of ordinals.
  """
  int value;

}

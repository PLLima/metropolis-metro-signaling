# This file contains rules for how variables should be named.
{
  format: "LCF2INTG-PACK-1.1",
  # Use named patterns to avoid duplication and improve documentation.
  # You refer to a named pattern with the "pattern" field in an
  # integration rule.
  patterns: [
    { name: DEFAULT,
      # Regular expression for extracting a part of the railyard
      # entity name. The match groups in this regular expression
      # can be referred to by the "integration" field of a integration
      # rule.
      lcf-match: '(.*)',
      def: 'Match the entire railyard entity name.'
    }
  ],
  # Default pattern to use if no "pattern" or "lcf-match" field is
  # specified for an integration rule.
  default-pattern: "DEFAULT",
  content: [

    # # SIGNAL
    # { predicate: "SIGNAL@ShowsProceed",
    #   rules: [{ integration: '\1GK', pattern: DEFAULT }] },
    # { predicate: "SIGNAL@CommandedProceed",
    #   rules: [{ integration: '\1G', pattern: DEFAULT }] },

  ]
}

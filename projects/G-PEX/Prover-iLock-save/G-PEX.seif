    P1.DATACHECK_03 [DesignName = 'DATACHECK_03', InstanceName = 'P1'] {Category = 'TRACK_CIRCUIT', Description = '\x0AThere are no switches in exit tracks.\x0A', GlobalUnivSplitOn = 'TRACK_CIRCUIT', OrigClassName = 'REQUIREMENTS', OrigInstanceName = 'requirements'},

    P4.DATACHECK_03 [DesignName = 'DATACHECK_03', InstanceName = 'P4'] {Category = 'TRACK_CIRCUIT', Description = '\x0AThere are no switches in exit tracks.\x0A', GlobalUnivSplitOn = 'TRACK_CIRCUIT', OrigClassName = 'REQUIREMENTS', OrigInstanceName = 'requirements'},
    P5.DATACHECK_03 [DesignName = 'DATACHECK_03', InstanceName = 'P5'] {Category = 'TRACK_CIRCUIT', Description = '\x0AThere are no switches in exit tracks.\x0A', GlobalUnivSplitOn = 'TRACK_CIRCUIT', OrigClassName = 'REQUIREMENTS', OrigInstanceName = 'requirements'},
    'S-p1.DATACHECK_01' [DesignName = 'DATACHECK_01', InstanceName = 'S-p1'] {Category = 'SIGNAL', Description = '\x0AThe track after an exit signal shall always be an exit track.\x0A', GlobalUnivSplitOn = 'SIGNAL', OrigClassName = 'REQUIREMENTS', OrigInstanceName = 'requirements'},
    'S-p1.GSS_01_1' [DesignName = 'GSS_01_1', InstanceName = 'S-p1'] {Category = 'SIGNAL', Description = '\x0AIf a signal is commanded to proceed, then one of the following holds:\x0A1. It is not an exit signal and there is a unique set route that\x0A   starts at the signal.\x0A2. It is an exit signal, it is end locked and the track circuit behind it\x0A   is clear of occupancy.\x0A', GlobalUnivSplitOn = 'SIGNAL', OrigClassName = 'REQUIREMENTS', OrigInstanceName = 'requirements'},
    'S-p1.GSS_01_2' [DesignName = 'GSS_01_2', InstanceName = 'S-p1'] {Category = 'SIGNAL', Description = '', GlobalUnivSplitOn = 'SIGNAL', OrigClassName = 'REQUIREMENTS', OrigInstanceName = 'requirements'},
    'S-p1.GSS_03' [DesignName = 'GSS_03', InstanceName = 'S-p1'] {Category = 'SIGNAL', Description = '\x0AIf a signal that is the start of a set route is commanded to proceed, then\x0Athe switches in the route are detected in their correct positions.\x0A\x0AThe switchess in the route are given by the relations Switch In\x0ANormal/Reverse relations from the route sections in the route.\x0A', GlobalUnivSplitOn = 'SIGNAL', OrigClassName = 'REQUIREMENTS', OrigInstanceName = 'requirements'},
    'S-p1.GSS_04' [DesignName = 'GSS_04', InstanceName = 'S-p1'] {Category = 'SIGNAL', Description = '\x0AIf a signal that is the start of a set route is commanded to proceed, then\x0Aall tracks in the route are clear from occupancy.\x0A\x0AThe tracks in the route are given by the tracks in the route sections in the\x0Aroute.\x0A', GlobalUnivSplitOn = 'SIGNAL', OrigClassName = 'REQUIREMENTS', OrigInstanceName = 'requirements'},
    'S-p1.GSS_05' [DesignName = 'GSS_05', InstanceName = 'S-p1'] {Category = 'SIGNAL', Description = '\x0AIf a signal that is the start of a set route is commanded to proceed, then,\x0Afor every switch in the route, there is a protection area that is protective\x0A(flank protection).\x0A', GlobalUnivSplitOn = 'SIGNAL', OrigClassName = 'REQUIREMENTS', OrigInstanceName = 'requirements'},
    'S-p1.GSS_06' [DesignName = 'GSS_06', InstanceName = 'S-p1'] {Category = 'SIGNAL', Description = '\x0AIf a signal that is the start of a set route is commanded to\x0Aproceed, then either the route ends at a buffer stop, ends at an\x0Aexit signal, the end signal is commanded to proceed, or there is\x0Aa protective area for the end signal that is protective (front\x0Aprotection)\x0A', GlobalUnivSplitOn = 'SIGNAL', OrigClassName = 'REQUIREMENTS', OrigInstanceName = 'requirements'},
    'S-p2.DATACHECK_01' [DesignName = 'DATACHECK_01', InstanceName = 'S-p2'] {Category = 'SIGNAL', Description = '\x0AThe track after an exit signal shall always be an exit track.\x0A', GlobalUnivSplitOn = 'SIGNAL', OrigClassName = 'REQUIREMENTS', OrigInstanceName = 'requirements'},

    'G-PEX'@'S-p2.ShowsProceed' := 'G-PEX'@'S-p2.CommandedProceed' & ~'S-p2@gts.GreenLampFailure';
    'G-PEX'@'S-p3.ShowsProceed' := 'G-PEX'@'S-p3.CommandedProceed' & ~'S-p3@gts.GreenLampFailure';
    'G-PEX'@'S-p4.ShowsProceed' := 'G-PEX'@'S-p4.CommandedProceed' & ~'S-p4@gts.GreenLampFailure';
    'G-PEX'@'S-p5.ShowsProceed' := 'G-PEX'@'S-p5.CommandedProceed' & ~'S-p5@gts.GreenLampFailure';
    'G-PEX'@S1.ShowsProceed := 'G-PEX'@S1.CommandedProceed & ~'S1@gts.GreenLampFailure';
    'G-PEX'@S2.ShowsProceed := 'G-PEX'@S2.CommandedProceed & ~'S2@gts.GreenLampFailure';
    'G-PEX'@S3.ShowsProceed := 'G-PEX'@S3.CommandedProceed & ~'S3@gts.GreenLampFailure';
    'G-PEX'@'SeG1-PEX-E.ShowsProceed' := 'G-PEX'@'SeG1-PEX-E.CommandedProceed' & ~'SeG1-PEX-E@gts.GreenLampFailure';
    'G-PEX'@'SeG2-PEX-E.ShowsProceed' := 'G-PEX'@'SeG2-PEX-E.CommandedProceed' & ~'SeG2-PEX-E@gts.GreenLampFailure';
    'G-PEX'@'sw-1.DetectedNormal' := 'sw-1@gts.DetectedNormal';
    'G-PEX'@'sw-1.DetectedReverse' := 'sw-1@gts.DetectedReverse';
    'G-PEX'@'sw-2.DetectedNormal' := 'sw-2@gts.DetectedNormal';
    'G-PEX'@'sw-2.DetectedReverse' := 'sw-2@gts.DetectedReverse';
    'G-PEX'@'sw-3.DetectedNormal' := 'sw-3@gts.DetectedNormal';
    'G-PEX'@'sw-3.DetectedReverse' := 'sw-3@gts.DetectedReverse';
    'G-PEX'@'sw-4.DetectedNormal' := 'sw-4@gts.DetectedNormal';
    'G-PEX'@'sw-4.DetectedReverse' := 'sw-4@gts.DetectedReverse';
    'G-PEX'@'sw-5.DetectedNormal' := 'sw-5@gts.DetectedNormal';
    'G-PEX'@'sw-5.DetectedReverse' := 'sw-5@gts.DetectedReverse';
  END FEEDBACKS

  TEST_CASES
    _INIT_.INITIALIZE_SYSTEM :=
    {
      ['\x0ASet all tracks clear.\x0A']
      ;
      'G-PEX'@P1.Clear := true;
      'G-PEX'@P2.Clear := true;
      'G-PEX'@P3.Clear := true;
      'G-PEX'@P4.Clear := true;
      'G-PEX'@P5.Clear := true;
      'G-PEX'@T1.Clear := true;
      'G-PEX'@T2.Clear := true;
      'G-PEX'@T3.Clear := true;
      'G-PEX'@T4.Clear := true;
      'G-PEX'@T5.Clear := true;
      'G-PEX'@T6.Clear := true;
      'G-PEX'@T7.Clear := true;
      'G-PEX'@T8.Clear := true;
      'G-PEX'@T9.Clear := true;
      'G-PEX'@'VG1-PEX.Clear' := true;
      'G-PEX'@'VG2-PEX.Clear' := true;
    }

    'S-p1-SeG2-PEX-E@gts.RUN_ROUTE' :=
    {
      [' Initialize the system. ']
      ;
      ['\x0ASet all tracks clear.\x0A']
      ;
      'G-PEX'@P1.Clear := true;
      'G-PEX'@P2.Clear := true;
      'G-PEX'@P3.Clear := true;
      'G-PEX'@P4.Clear := true;
      'G-PEX'@P5.Clear := true;
      'G-PEX'@T1.Clear := true;
      'G-PEX'@T2.Clear := true;
      'G-PEX'@T3.Clear := true;
      'G-PEX'@T4.Clear := true;
      'G-PEX'@T5.Clear := true;
      'G-PEX'@T6.Clear := true;
      'G-PEX'@T7.Clear := true;
      'G-PEX'@T8.Clear := true;
      'G-PEX'@T9.Clear := true;
      'G-PEX'@'VG1-PEX.Clear' := true;
      'G-PEX'@'VG2-PEX.Clear' := true;
      [' Request all switches in the route in their proper positions. ']
      ;
      'G-PEX'@'sw-2.RequestedNormal' := true;
      'G-PEX'@'sw-5.RequestedNormal' := true;
      'G-PEX'@'sw-3.RequestedReverse' := true;
      wait 1 sec;
      'G-PEX'@'sw-2.RequestedNormal' := false;
      'G-PEX'@'sw-2.RequestedReverse' := false;
      'G-PEX'@'sw-3.RequestedNormal' := false;
      'G-PEX'@'sw-3.RequestedReverse' := false;
      'G-PEX'@'sw-5.RequestedNormal' := false;
      'G-PEX'@'sw-5.RequestedReverse' := false;
      ['\x0AAssert that all switches in the route are in correspondence in proper\x0Apositions.\x0A']
      expect 'G-PEX'@'sw-2.CommandedNormal' & 'G-PEX'@'sw-2.DetectedNormal' & ~'G-PEX'@'sw-2.DetectedReverse' & 'G-PEX'@'sw-3.CommandedReverse' & 'G-PEX'@'sw-3.DetectedReverse' & ~'G-PEX'@'sw-3.DetectedNormal' & 'G-PEX'@'sw-5.CommandedNormal' & 'G-PEX'@'sw-5.DetectedNormal' & ~'G-PEX'@'sw-5.DetectedReverse' within 5 sec;
      ['\x0AAssert that the flank of the route is protected.\x0A']
      expect 'G-PEX'@T2.Clear & ('G-PEX'@T7.Clear & 'G-PEX'@'sw-4.CommandedNormal' & 'G-PEX'@'sw-4.DetectedNormal' & ~'G-PEX'@'sw-4.DetectedReverse' # 'G-PEX'@T6.Clear & 'G-PEX'@T7.Clear) & 'G-PEX'@T2.Clear;
      ['\x0AIf the route does not end in a buffer stop or an exit signal, assert that\x0Athe front of the route is protected.\x0A']
      expect true;
      [' Request the route. ']
      'G-PEX'@'S-p1-SeG2-PEX-E.RouteRequested' := true;
      wait 1 sec;
      'G-PEX'@'S-p1-SeG2-PEX-E.RouteRequested' := false;
      [' Assert that the route is set. ']
      expect 'G-PEX'@T2E.Locked & 'G-PEX'@T5E.Locked & 'G-PEX'@T7E1.Locked & 'G-PEX'@T8E.Locked;
      [' Assert that the start signal is commanded proceed and shows proceed. ']
      expect 'G-PEX'@'S-p1.CommandedProceed' & 'G-PEX'@'S-p1.ShowsProceed';
      [' Occupy the track immediately before the route. ']
      ;
      'G-PEX'@P1.Clear := false;
      wait 1 sec;
      [' Occupy the first track of the route. ']
      ;
      'G-PEX'@T2.Clear := false;
      wait 1 sec;
      ['\x0AAssert that the start signal is neither commanded to proceed nor shows\x0Aproceed.\x0A']
      expect ~'G-PEX'@'S-p1.CommandedProceed' & ~'G-PEX'@'S-p1.ShowsProceed';
      [' Vacate the track immediately before the route. ']
      ;
      'G-PEX'@P1.Clear := true;
      wait 1 sec;
      ['\x0ATraverse the rest of the route and assert that locking of route sections\x0Areleases as the train passes over them.\x0A']
      ;
      [' Occupy track T5. ']
      'G-PEX'@T5.Clear := false;
      wait 1 sec;
      [' Vacate track T2. ']
      ;
      'G-PEX'@T2.Clear := true;
      wait 1 sec;
      ['\x0AIf the track just vacated is the last track in the route section that\x0Acontains it, assert that the locking of this route section releases.\x0A']
      expect ~'G-PEX'@T2E.Locked;
      [' Occupy track T7. ']
      'G-PEX'@T7.Clear := false;
      wait 1 sec;
      [' Vacate track T5. ']
      ;
      'G-PEX'@T5.Clear := true;
      wait 1 sec;
      ['\x0AIf the track just vacated is the last track in the route section that\x0Acontains it, assert that the locking of this route section releases.\x0A']
      expect ~'G-PEX'@T5E.Locked;
      [' Occupy track T8. ']
      'G-PEX'@T8.Clear := false;
      wait 1 sec;
      [' Vacate track T7. ']
      ;
      'G-PEX'@T7.Clear := true;
      wait 1 sec;
      ['\x0AIf the track just vacated is the last track in the route section that\x0Acontains it, assert that the locking of this route section releases.\x0A']
      expect ~'G-PEX'@T7E1.Locked;
      [' Occupy the track immediately after the route. ']
      ;
      'G-PEX'@'VG2-PEX.Clear' := false;
      wait 1 sec;
      [' Vacate the last track of the route. ']
      ;
      'G-PEX'@T8.Clear := true;
      wait 1 sec;
      [' Assert that the locking of the last route section is released. ']
      expect 'G-PEX'@T8E.Locked;
    }


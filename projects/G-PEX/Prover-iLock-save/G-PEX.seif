      expect 'G-PEX'@'sw-1.CommandedNormal' & 'G-PEX'@'sw-1.DetectedNormal' & ~'G-PEX'@'sw-1.DetectedReverse' & 'G-PEX'@'sw-4.CommandedNormal' & 'G-PEX'@'sw-4.DetectedNormal' & ~'G-PEX'@'sw-4.DetectedReverse' within 5 sec;
      ['\x0AAssert that the flank of the route is protected.\x0A']
      expect 'G-PEX'@T1.Clear & ('G-PEX'@T6.Clear & 'G-PEX'@'sw-5.CommandedNormal' & 'G-PEX'@'sw-5.DetectedNormal' & ~'G-PEX'@'sw-5.DetectedReverse' # 'G-PEX'@T6.Clear & 'G-PEX'@T7.Clear & 'G-PEX'@T8.Clear);
      ['\x0AIf the route does not end in a buffer stop or an exit signal, assert that\x0Athe front of the route is protected.\x0A']
      expect true;
      [' Request the route. ']
      'G-PEX'@'S3-S-p4b.RouteRequested' := true;
      wait 1 sec;
      'G-PEX'@'S3-S-p4b.RouteRequested' := false;
      [' Assert that the route is set. ']
      expect 'G-PEX'@P4W.Locked & 'G-PEX'@T1W1.Locked & 'G-PEX'@T3W.Locked & 'G-PEX'@T4W.Locked & 'G-PEX'@T6W.Locked & 'G-PEX'@T9W.Locked;
      [' Assert that the start signal is commanded proceed and shows proceed. ']
      expect 'G-PEX'@S3.CommandedProceed & 'G-PEX'@S3.ShowsProceed;
      [' Occupy the track immediately before the route. ']
      ;
      'G-PEX'@'VG1-PEX.Clear' := false;
      wait 1 sec;
      [' Occupy the first track of the route. ']
      ;
      'G-PEX'@T9.Clear := false;
      wait 1 sec;
      ['\x0AAssert that the start signal is neither commanded to proceed nor shows\x0Aproceed.\x0A']
      expect ~'G-PEX'@S3.CommandedProceed & ~'G-PEX'@S3.ShowsProceed;
      [' Vacate the track immediately before the route. ']
      ;
      'G-PEX'@'VG1-PEX.Clear' := true;
      wait 1 sec;
      ['\x0ATraverse the rest of the route and assert that locking of route sections\x0Areleases as the train passes over them.\x0A']
      ;
      [' Occupy track T6. ']
      'G-PEX'@T6.Clear := false;
      wait 1 sec;
      [' Vacate track T9. ']
      ;
      'G-PEX'@T9.Clear := true;
      wait 1 sec;
      ['\x0AIf the track just vacated is the last track in the route section that\x0Acontains it, assert that the locking of this route section releases.\x0A']
      expect ~'G-PEX'@T9W.Locked;
      [' Occupy track T4. ']
      'G-PEX'@T4.Clear := false;
      wait 1 sec;
      [' Vacate track T6. ']
      ;
      'G-PEX'@T6.Clear := true;
      wait 1 sec;
      ['\x0AIf the track just vacated is the last track in the route section that\x0Acontains it, assert that the locking of this route section releases.\x0A']
      expect ~'G-PEX'@T6W.Locked;
      [' Occupy track T3. ']
      'G-PEX'@T3.Clear := false;
      wait 1 sec;
      [' Vacate track T4. ']
      ;
      'G-PEX'@T4.Clear := true;
      wait 1 sec;
      ['\x0AIf the track just vacated is the last track in the route section that\x0Acontains it, assert that the locking of this route section releases.\x0A']
      expect ~'G-PEX'@T4W.Locked;
      [' Occupy track T1. ']
      'G-PEX'@T1.Clear := false;
      wait 1 sec;
      [' Vacate track T3. ']
      ;
      'G-PEX'@T3.Clear := true;
      wait 1 sec;
      ['\x0AIf the track just vacated is the last track in the route section that\x0Acontains it, assert that the locking of this route section releases.\x0A']
      expect ~'G-PEX'@T3W.Locked;
      [' Occupy track P4. ']
      'G-PEX'@P4.Clear := false;
      wait 1 sec;
      [' Vacate track T1. ']
      ;
      'G-PEX'@T1.Clear := true;
      wait 1 sec;
      ['\x0AIf the track just vacated is the last track in the route section that\x0Acontains it, assert that the locking of this route section releases.\x0A']
      expect ~'G-PEX'@T1W1.Locked;
      wait 1 sec;
      [' Vacate the last track of the route. ']
      ;
      'G-PEX'@P4.Clear := true;
      wait 1 sec;
      [' Assert that the locking of the last route section is released. ']
      expect 'G-PEX'@P4W.Locked;
    }

    'S3-S-p5b@gts.RUN_ROUTE' :=
    {
      [' Initialize the system. ']
      ;
      ['\x0ASet all tracks clear.\x0A']
      ;
      'G-PEX'@P1.Clear := true;
      'G-PEX'@P2.Clear := true;
      'G-PEX'@P3.Clear := true;
      'G-PEX'@P4.Clear := true;
      'G-PEX'@P5.Clear := true;
      'G-PEX'@T1.Clear := true;
      'G-PEX'@T2.Clear := true;
      'G-PEX'@T3.Clear := true;
      'G-PEX'@T4.Clear := true;
      'G-PEX'@T5.Clear := true;
      'G-PEX'@T6.Clear := true;
      'G-PEX'@T7.Clear := true;
      'G-PEX'@T8.Clear := true;
      'G-PEX'@T9.Clear := true;
      'G-PEX'@'VG1-PEX.Clear' := true;
      'G-PEX'@'VG2-PEX.Clear' := true;
      [' Request all switches in the route in their proper positions. ']
      ;
      'G-PEX'@'sw-4.RequestedNormal' := true;
      'G-PEX'@'sw-1.RequestedReverse' := true;
      wait 1 sec;
      'G-PEX'@'sw-1.RequestedNormal' := false;
      'G-PEX'@'sw-1.RequestedReverse' := false;
      'G-PEX'@'sw-4.RequestedNormal' := false;
      'G-PEX'@'sw-4.RequestedReverse' := false;
      ['\x0AAssert that all switches in the route are in correspondence in proper\x0Apositions.\x0A']
      expect 'G-PEX'@'sw-1.CommandedReverse' & 'G-PEX'@'sw-1.DetectedReverse' & ~'G-PEX'@'sw-1.DetectedNormal' & 'G-PEX'@'sw-4.CommandedNormal' & 'G-PEX'@'sw-4.DetectedNormal' & ~'G-PEX'@'sw-4.DetectedReverse' within 5 sec;
      ['\x0AAssert that the flank of the route is protected.\x0A']
      expect ('G-PEX'@T6.Clear & 'G-PEX'@'sw-5.CommandedNormal' & 'G-PEX'@'sw-5.DetectedNormal' & ~'G-PEX'@'sw-5.DetectedReverse' # 'G-PEX'@T6.Clear & 'G-PEX'@T7.Clear & 'G-PEX'@T8.Clear) & 'G-PEX'@T1.Clear;
      ['\x0AIf the route does not end in a buffer stop or an exit signal, assert that\x0Athe front of the route is protected.\x0A']
      expect true;
      [' Request the route. ']
      'G-PEX'@'S3-S-p5b.RouteRequested' := true;
      wait 1 sec;
      'G-PEX'@'S3-S-p5b.RouteRequested' := false;
      [' Assert that the route is set. ']
      expect 'G-PEX'@P5W.Locked & 'G-PEX'@T1W.Locked & 'G-PEX'@T3W.Locked & 'G-PEX'@T4W.Locked & 'G-PEX'@T6W.Locked & 'G-PEX'@T9W.Locked;
      [' Assert that the start signal is commanded proceed and shows proceed. ']
      expect 'G-PEX'@S3.CommandedProceed & 'G-PEX'@S3.ShowsProceed;
      [' Occupy the track immediately before the route. ']
      ;
      'G-PEX'@'VG1-PEX.Clear' := false;
      wait 1 sec;
      [' Occupy the first track of the route. ']
      ;
      'G-PEX'@T9.Clear := false;
      wait 1 sec;
      ['\x0AAssert that the start signal is neither commanded to proceed nor shows\x0Aproceed.\x0A']
      expect ~'G-PEX'@S3.CommandedProceed & ~'G-PEX'@S3.ShowsProceed;
      [' Vacate the track immediately before the route. ']
      ;
      'G-PEX'@'VG1-PEX.Clear' := true;
      wait 1 sec;
      ['\x0ATraverse the rest of the route and assert that locking of route sections\x0Areleases as the train passes over them.\x0A']
      ;
      [' Occupy track T6. ']
      'G-PEX'@T6.Clear := false;
      wait 1 sec;
      [' Vacate track T9. ']
      ;
      'G-PEX'@T9.Clear := true;
      wait 1 sec;
      ['\x0AIf the track just vacated is the last track in the route section that\x0Acontains it, assert that the locking of this route section releases.\x0A']
      expect ~'G-PEX'@T9W.Locked;
      [' Occupy track T4. ']
      'G-PEX'@T4.Clear := false;
      wait 1 sec;
      [' Vacate track T6. ']
      ;
      'G-PEX'@T6.Clear := true;
      wait 1 sec;
      ['\x0AIf the track just vacated is the last track in the route section that\x0Acontains it, assert that the locking of this route section releases.\x0A']
      expect ~'G-PEX'@T6W.Locked;
      [' Occupy track T3. ']
      'G-PEX'@T3.Clear := false;
      wait 1 sec;
      [' Vacate track T4. ']
      ;
      'G-PEX'@T4.Clear := true;
      wait 1 sec;
      ['\x0AIf the track just vacated is the last track in the route section that\x0Acontains it, assert that the locking of this route section releases.\x0A']
      expect ~'G-PEX'@T4W.Locked;
      [' Occupy track T1. ']
      'G-PEX'@T1.Clear := false;
      wait 1 sec;
      [' Vacate track T3. ']
      ;
      'G-PEX'@T3.Clear := true;
      wait 1 sec;
      ['\x0AIf the track just vacated is the last track in the route section that\x0Acontains it, assert that the locking of this route section releases.\x0A']
      expect ~'G-PEX'@T3W.Locked;
      [' Occupy track P5. ']
      'G-PEX'@P5.Clear := false;
      wait 1 sec;
      [' Vacate track T1. ']
      ;
      'G-PEX'@T1.Clear := true;
      wait 1 sec;
      ['\x0AIf the track just vacated is the last track in the route section that\x0Acontains it, assert that the locking of this route section releases.\x0A']
      expect ~'G-PEX'@T1W.Locked;
      wait 1 sec;
      [' Vacate the last track of the route. ']
      ;
      'G-PEX'@P5.Clear := true;
      wait 1 sec;
      [' Assert that the locking of the last route section is released. ']
      expect 'G-PEX'@P5W.Locked;
    }
  END TEST_CASES

END TEST_PROGRAM


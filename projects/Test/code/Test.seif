    S1-B3.JustUnlocked [DesignName = 'JustUnlocked', InstanceName = 'S1-B3'] {'$f' = '000000000', Description = '\x0AThe route stops being locked by a manual release request and will \x0Aforce its route sections to do the same. This either happens after\x0Athe 30s release timer has expired, or immediately, based on certain conditions.\x0A', DeviationName = '["Test"."S1-B3.JustUnlocked"]', OriginalName = 'S1-B3.JustUnlocked'},

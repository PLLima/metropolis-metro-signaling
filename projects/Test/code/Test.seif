    S02W.CommandedProceed [DesignName = 'CommandedProceed', InstanceName = 'S02W'] {'$f' = '000000000', Description = '\x0AThe signal is commanded to show proceed.\x0AFor non-exit signals, this happens when there is a route starting at the\x0Asignal that is ready to proceed.\x0AFor exit signals, this happens when the signal is endlocked and the track\x0Acircuit behind it is clear of occupancy.\x0A', DeviationName = '["Test"."S02W.CommandedProceed"]', OriginalName = 'S02W.CommandedProceed'},
    S02W.LineInput [DesignName = 'LineInput', InstanceName = 'S02W'] {Description = '\x0AInput from neighbouring station indicating that the exit signal at the\x0Aother end of the line is at stop and not end locked.\x0A', DeviationName = '["Test"."S02W.LineInput"]', OriginalName = 'S02W.LineInput', SimulatorInitialValue = 'True'},
    S02W.LineOutput [DesignName = 'LineOutput', InstanceName = 'S02W'] {'$f' = '000000001', Description = '\x0AOutput to neighbouring station indicating that this exit signal is at stop\x0Aand not end locked.\x0A', DeviationName = '["Test"."S02W.LineOutput"]', OriginalName = 'S02W.LineOutput'},

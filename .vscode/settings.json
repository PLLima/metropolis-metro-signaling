{
  "latex-workshop.latex.clean.method": "glob",
  "latex-workshop.latex.autoClean.run": "onBuilt",
  "latex-workshop.latex.clean.subfolder.enabled": true,
  "latex-workshop.latex.clean.fileTypes": [
    "*.aux",
    "*.bbl",
    "*.blg",
    "*.idx",
    "*.ind",
    "*.lof",
    "*.lot",
    "*.out",
    "*.toc",
    "*.acn",
    "*.acr",
    "*.alg",
    "*.glg",
    "*.glo",
    "*.gls",
    "*.fls",
    "*.log",
    "*.fdb_latexmk",
    "*.snm",
    "*.nav",
    "*.vrb",
    "*.synctex.gz",
    "*.synctex",
    "*.synctex(busy)",
    "*.synctex.gz(busy)",
    "*.bcf",
    "*.run.xml",
    "%DOCFILE%.aux",
    "%DOCFILE%.bbl",
    "%DOCFILE%.blg",
    "%DOCFILE%.out",
    "%DOCFILE%.toc",
    "%DOCFILE%.log",
    "%DOCFILE%.synctex.gz",
    "%DOCFILE%.synctex",
    "%DOCFILE%.synctex(busy)",
    "%DOCFILE%.synctex.gz(busy)",
    "%DOCFILE%.bcf",
    "%DOCFILE%.run.xml"
  ]
}
